# Public application URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_CLINICIAN_PORTAL_URL=

# Authentication — Supabase public values may be exposed to the browser; service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — server-only. Configure only the providers you enable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Email — server-only. Configure one provider.
RESEND_API_KEY=
SENDGRID_API_KEY=

# Payments — server-only except the publishable browser key.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage — server-only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=

# Analytics and SEO
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=
GOOGLE_SEARCH_CONSOLE=
BING_WEBMASTER_API_KEY=
