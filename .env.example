# NeuroCare Platform - Environment Configuration
# Copy to .env and adjust per environment (dev/staging/prod)

# Branch / environment / variable configuration
ENVIRONMENT=dev
BRANCH=launch-it-rewire-audit-engine
APP_NAME=neurocare-platform

# Ports
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Database
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic

# Auth / JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production

# URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
